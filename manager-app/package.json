{
  "name": "gigalator-manager",
  "version": "1.0.0",
  "description": "Gigalator Manager — Desktop app for managing songs, lyrics, and backing tracks",
  "main": "main.js",
  "author": "Darren Johnstone",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:dir": "electron-builder --mac dir",
    "dist:signed": "electron-builder --mac dmg --config.mac.identity=$CSC_NAME"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.darrenjohnstone.gigalator-manager",
    "productName": "Gigalator Manager",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../manager.html",
        "to": "manager.html"
      },
      {
        "from": "../api",
        "to": "api",
        "filter": [
          "**/*",
          "!.env",
          "!node_modules/.cache/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "title": "Gigalator Manager ${version}",
      "contents": [
        { "x": 130, "y": 220, "type": "file" },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
